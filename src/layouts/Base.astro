---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { site } from '../data/site';
import { href } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  noindex?: boolean;
}
const { title, description = site.description, lang = 'en-GB', noindex = false } = Astro.props;
const fullTitle = title ? `${title} — hasib` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Link preview image (regenerate with scripts/render-og.py).
const ogImage = new URL(href('/og.png'), Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Analytics part="head" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="hasib" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="hasib: Machine learning systems, from data to deployment." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <meta name="theme-color" content="#FAFAF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121418" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500&display=swap"
    />
    <script is:inline>
      // Apply a saved theme before first paint so there is no flash.
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <Analytics part="body" />
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -100px;
    z-index: 200;
    padding: var(--s3) var(--s4);
    background: var(--btn-bg);
    color: var(--btn-text);
    font-weight: 500;
    text-decoration: none;
  }
  .skip:focus {
    top: var(--s3);
  }
  main:focus {
    outline: none;
  }
</style>

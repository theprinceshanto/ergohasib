---
interface Props {
  folio: string;
  label: string;
  title: string;
  lede?: string;
}
const { folio, label, title, lede } = Astro.props;
---

<header class="page-head">
  <div class="wrap grid">
    <div class="page-head__meta rise">
      <span class="folio" aria-hidden="true">{folio}</span>
      <span class="label">{label}</span>
    </div>
    <div class="page-head__body">
      <h1 class="rise rise-2">{title}</h1>
      {lede && <p class="lede rise rise-3">{lede}</p>}
      <slot />
    </div>
  </div>
</header>

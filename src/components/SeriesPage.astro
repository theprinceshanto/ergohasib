---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PostList from './PostList.astro';
import { getPosts } from '../lib/content';
import { seriesInfo, type SeriesKey } from '../data/site';

interface Props {
  series: SeriesKey;
  emptyText: string;
}
const { series, emptyText } = Astro.props;
const info = seriesInfo(series)!;
const { name, tagline, description } = info;
const posts = (await getPosts()).filter((p) => p.data.series === series);
---

<Base title={name} description={`${tagline} ${description}`}>
  <header class="series-head">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Writing', href: '/writing' }, { label: name }]} />
      <p class="label label--accent">Series</p>
      <h1 class="rise">{name}</h1>
      <p class="lede rise rise-2">{tagline}</p>
      <p class="series-head__desc rise rise-3">{description}</p>
    </div>
  </header>
  <div class="wrap">
    {
      posts.length > 0 ? (
        <PostList posts={posts} />
      ) : (
        <div class="empty">
          <p>{emptyText}</p>
        </div>
      )
    }
  </div>
</Base>

<style>
  .series-head {
    padding-block: var(--s5) var(--s8);
  }
  .series-head .label {
    margin-top: var(--s6);
  }
  .series-head__desc {
    margin-top: var(--s3);
    max-width: 38em;
    color: var(--text-2);
    text-wrap: pretty;
  }
  .series-head h1 {
    margin-block: var(--s3) var(--s5);
    font-size: clamp(3rem, 1.5rem + 7vw, 8rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
</style>

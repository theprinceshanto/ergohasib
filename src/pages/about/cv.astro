---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../data/site';
import { profile, experience, education, skills } from '../../data/cv';
import { getWork } from '../../lib/content';
import { href } from '../../lib/url';

const work = await getWork();
---

<Base title="CV" description="CV of Hasib, machine learning engineering.">
  <div class="wrap">
    <Breadcrumbs items={[{ label: 'About', href: '/about' }, { label: 'CV' }]} />

    <header class="cv-head">
      <div>
        <h1>Hasib</h1>
        <p class="lede">Machine learning engineering</p>
      </div>
      <div class="cv-head__actions">
        {
          site.cvPdf && (
            <a class="btn" href={href(site.cvPdf)} download>
              Download PDF
            </a>
          )
        }
        <button class="btn btn--ghost" type="button" data-print>Print</button>
      </div>
    </header>

    <div class="cv">
      <section class="cv-row" aria-labelledby="cv-profile">
        <h2 id="cv-profile" class="label">Profile</h2>
        <p class="cv-profile">{profile}</p>
      </section>

      <section class="cv-row" aria-labelledby="cv-projects">
        <h2 id="cv-projects" class="label">Projects</h2>
        <ul class="cv-list">
          {
            work.map((p) => (
              <li>
                <p class="cv-item__title">
                  <a class="link" href={href(`/work/${p.id}`)}>
                    {p.data.code}: {p.data.title}
                  </a>
                  <span class="status" data-status={p.data.status}>
                    {p.data.status}
                  </span>
                </p>
                <p class="cv-item__sub">{p.data.deck}</p>
                <p class="cv-item__meta muted">{p.data.data}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="cv-row" aria-labelledby="cv-experience">
        <h2 id="cv-experience" class="label">Experience</h2>
        <ul class="cv-list">
          {
            experience.map((e) => (
              <li>
                <p class="cv-item__title">
                  {e.role}
                  {e.dates && <span class="muted cv-item__dates">{e.dates}</span>}
                </p>
                {(e.org || e.place) && <p class="cv-item__sub">{[e.org, e.place].filter(Boolean).join(' · ')}</p>}
                <ul class="cv-points">
                  {e.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="cv-row" aria-labelledby="cv-education">
        <h2 id="cv-education" class="label">Education</h2>
        <ul class="cv-list">
          {
            education.map((e) => (
              <li>
                <p class="cv-item__title">
                  {e.title}
                  {e.dates && <span class="muted cv-item__dates">{e.dates}</span>}
                </p>
                <p class="cv-item__sub">{e.org}</p>
                {e.detail && <p class="cv-item__meta muted">{e.detail}</p>}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="cv-row" aria-labelledby="cv-skills">
        <h2 id="cv-skills" class="label">Skills</h2>
        <dl class="cv-skills">
          {
            skills.map((s) => (
              <div>
                <dt>{s.area}</dt>
                <dd>{s.items}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </div>
</Base>

<style>
  .cv-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s5);
    padding-block: var(--s6) var(--s6);
    border-bottom: 1px solid var(--text);
  }
  .cv-head h1 {
    font-size: clamp(3rem, 2rem + 4vw, 5rem);
    letter-spacing: -0.04em;
  }
  .cv-head__actions {
    display: flex;
    gap: var(--s2);
  }
  .cv-row {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: var(--s5);
    padding-block: var(--s6);
    border-bottom: 1px solid var(--rule);
  }
  .cv-row > .label {
    padding-top: 4px;
  }
  .cv-profile {
    font-size: 1.1875rem;
    line-height: 1.6;
    max-width: 40em;
  }
  .cv-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s5);
  }
  .cv-item__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s4);
    font-size: 1.1875rem;
    font-weight: 500;
  }
  .cv-item__dates {
    font-weight: 400;
    font-size: 0.9375rem;
  }
  .cv-item__sub {
    color: var(--text-2);
  }
  .cv-item__meta {
    font-size: 0.875rem;
  }
  .cv-points {
    margin: var(--s2) 0 0;
    padding-left: 1.2em;
    color: var(--text-body);
  }
  .cv-points li::marker {
    color: var(--accent);
  }
  .cv-skills {
    margin: 0;
    display: grid;
    gap: var(--s3);
  }
  .cv-skills div {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--s4);
  }
  .cv-skills dt {
    font-weight: 500;
  }
  .cv-skills dd {
    margin: 0;
    color: var(--text-2);
  }
  @media (max-width: 700px) {
    .cv-row,
    .cv-skills div {
      grid-template-columns: 1fr;
      gap: var(--s2);
    }
    .cv-row {
      gap: var(--s4);
    }
  }
  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.crumbs),
    :global(.skip),
    .cv-head__actions {
      display: none !important;
    }
    :global(body::before) {
      display: none;
    }
  }
</style>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

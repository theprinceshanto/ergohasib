---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../data/site';
import { cvName, cvTitle, cvLocation, profile, experience, extraProjects, education, skills } from '../../data/cv';
import { getWork } from '../../lib/content';
import { href } from '../../lib/url';

const work = await getWork();
const contact = [
  { label: cvLocation },
  site.email && { label: site.email, url: `mailto:${site.email}` },
  site.linkedin && { label: 'linkedin.com/in/ergohasib', url: site.linkedin },
  site.github && { label: 'github.com/theprinceshanto', url: site.github },
  { label: 'ergohasib.com', url: 'https://ergohasib.com' },
].filter((c): c is { label: string; url?: string } => Boolean(c));
---

<Base title="CV" description={`CV of ${cvName}: machine learning engineering, software and quality.`}>
  <div class="wrap">
    <Breadcrumbs items={[{ label: 'About', href: '/about' }, { label: 'CV' }]} />

    <header class="cv-head">
      <div class="cv-head__id">
        <h1>{cvName}</h1>
        <p class="lede">{cvTitle}</p>
        <ul class="cv-contact">
          {contact.map((c) => <li>{c.url ? <a class="link" href={c.url}>{c.label}</a> : c.label}</li>)}
        </ul>
      </div>
      <div class="cv-head__actions">
        {
          site.cvPdf && (
            <a class="btn" href={href(site.cvPdf)} download="Al-Hasib-Prince-Shanto-CV.pdf">
              Download PDF
            </a>
          )
        }
        <button class="btn btn--ghost" type="button" data-print>Print</button>
      </div>
    </header>

    <div class="cv">
      <section class="cv-row" aria-labelledby="cv-profile">
        <h2 id="cv-profile" class="label">Profile</h2>
        <p class="cv-profile">{profile}</p>
      </section>

      <section class="cv-row" aria-labelledby="cv-experience">
        <h2 id="cv-experience" class="label">Experience</h2>
        <ul class="cv-list">
          {
            experience.map((e) => (
              <li>
                <p class="cv-item__title">
                  {e.role}
                  {e.dates && <span class="muted cv-item__dates">{e.dates}</span>}
                </p>
                {(e.org || e.place) && <p class="cv-item__sub">{[e.org, e.place].filter(Boolean).join(' · ')}</p>}
                <ul class="cv-points">
                  {e.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="cv-row" aria-labelledby="cv-projects">
        <h2 id="cv-projects" class="label">Projects</h2>
        <ul class="cv-list">
          {
            extraProjects.map((p) => (
              <li>
                <p class="cv-item__title">{p.title}</p>
                <p class="cv-item__meta muted">{p.stack}</p>
                <ul class="cv-points">
                  {p.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              </li>
            ))
          }
          {
            work.map((p) => (
              <li>
                <p class="cv-item__title">
                  <a class="link" href={href(`/work/${p.id}`)}>
                    {p.data.code}: {p.data.title}
                  </a>
                  <span class="status" data-status={p.data.status}>
                    {p.data.status}
                  </span>
                </p>
                <p class="cv-item__sub">{p.data.deck}</p>
                <p class="cv-item__meta muted">{p.data.data}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="cv-row" aria-labelledby="cv-education">
        <h2 id="cv-education" class="label">Education</h2>
        <ul class="cv-list">
          {
            education.map((e) => (
              <li>
                <p class="cv-item__title">
                  {e.title}
                  {e.dates && <span class="muted cv-item__dates">{e.dates}</span>}
                </p>
                <p class="cv-item__sub">{e.org}</p>
                {e.detail && <p class="cv-item__meta muted">{e.detail}</p>}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="cv-row" aria-labelledby="cv-skills">
        <h2 id="cv-skills" class="label">Skills</h2>
        <dl class="cv-skills">
          {
            skills.map((s) => (
              <div>
                <dt>{s.area}</dt>
                <dd>{s.items}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </div>
</Base>

<style>
  .cv-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s5);
    padding-block: var(--s6) var(--s6);
    border-bottom: 1px solid var(--text);
  }
  .cv-head h1 {
    font-size: clamp(2.5rem, 1.6rem + 3vw, 4rem);
    letter-spacing: -0.035em;
  }
  .cv-head__id {
    display: grid;
    gap: var(--s2);
  }
  .cv-contact {
    list-style: none;
    margin: var(--s2) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s4);
    font-size: 0.9375rem;
    color: var(--text-2);
  }
  .cv-contact li {
    overflow-wrap: anywhere;
  }
  .cv-head__actions {
    display: flex;
    gap: var(--s2);
  }
  .cv-row {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: var(--s5);
    padding-block: var(--s6);
    border-bottom: 1px solid var(--rule);
  }
  .cv-row > .label {
    padding-top: 4px;
  }
  .cv-profile {
    font-size: 1.1875rem;
    line-height: 1.6;
    max-width: 40em;
  }
  .cv-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s5);
  }
  .cv-item__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s4);
    font-size: 1.1875rem;
    font-weight: 500;
  }
  .cv-item__dates {
    font-weight: 400;
    font-size: 0.9375rem;
  }
  .cv-item__sub {
    color: var(--text-2);
  }
  .cv-item__meta {
    font-size: 0.875rem;
  }
  .cv-points {
    margin: var(--s2) 0 0;
    padding-left: 1.2em;
    color: var(--text-body);
  }
  .cv-points li::marker {
    color: var(--accent);
  }
  .cv-skills {
    margin: 0;
    display: grid;
    gap: var(--s3);
  }
  .cv-skills div {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--s4);
  }
  .cv-skills dt {
    font-weight: 500;
  }
  .cv-skills dd {
    margin: 0;
    color: var(--text-2);
  }
  @media (max-width: 700px) {
    .cv-row,
    .cv-skills div {
      grid-template-columns: 1fr;
      gap: var(--s2);
    }
    .cv-row {
      gap: var(--s4);
    }
  }
  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.crumbs),
    :global(.skip),
    .cv-head__actions {
      display: none !important;
    }
    :global(body::before) {
      display: none;
    }
    /* A4, compact: the PDF is generated from this (scripts/render-cv.py). */
    @page {
      size: A4;
      margin: 14mm 15mm;
    }
    :global(html) {
      font-size: 12px;
    }
    :global(main) {
      padding: 0;
    }
    :global(.wrap) {
      max-width: none;
      padding: 0;
    }
    .cv-head {
      padding-block: 0 var(--s4);
      border-bottom-width: 1.5px;
    }
    .cv-head h1 {
      font-size: 2.6rem;
    }
    .cv-row {
      grid-template-columns: 9rem minmax(0, 1fr);
      padding-block: var(--s4);
    }
    .cv-profile {
      font-size: 1.05rem;
    }
    .cv-list {
      gap: var(--s3);
    }
    .cv-list > li,
    .cv-skills div {
      break-inside: avoid;
    }
    .cv-item__title {
      font-size: 1.1rem;
    }
    .link {
      text-decoration: none;
    }
  }
</style>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

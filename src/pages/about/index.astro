---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import portrait from '../../assets/images/portrait.jpg';
import PageHead from '../../components/PageHead.astro';
import { stack } from '../../data/cv';
import { href } from '../../lib/url';

const path = [
  { place: 'Mymensingh', what: 'Mathematics', detail: 'BSc at Anandamohan College. Probability, statistics, linear algebra.' },
  {
    place: 'Coding',
    what: 'Building for the web',
    detail: 'Started as a hobby: websites for a web agency, then small software projects of my own.',
  },
  {
    place: 'Software quality',
    what: 'Finding out whether it works',
    detail: 'Testing systems, tracking where they break and reading the patterns in the failures.',
  },
  { place: 'Aelnir', what: 'Building products', detail: 'Founded an app studio to turn problems into products.' },
  {
    place: 'Now',
    what: 'Machine learning engineering',
    detail: 'Building models with tests, honest evaluation and a deployed demo.',
  },
];
---

<Base title="About" description="Hasib: from a maths degree in Mymensingh, through software quality engineering, to machine learning engineering.">
  <PageHead folio="04" label="About" title="Find out whether it really works." />

  <div class="wrap">
    <div class="grid about">
      <figure class="about__portrait">
        <Image
          src={portrait}
          alt="Hasib, a black-and-white portrait"
          widths={[320, 480, 640]}
          sizes="(max-width: 760px) 100vw, (max-width: 1000px) 30vw, 280px"
          loading="eager"
        />
      </figure>
      <div class="about__story prose">
        <p>
          I build machine learning systems that work outside a notebook, from the data to the deployed model.
        </p>
        <p>
          I didn’t fall for mathematics because of the proofs. At Anandamohan College in Mymensingh, what held my
          attention was probability, statistics and linear algebra, the parts where numbers start describing something
          real. I liked theory well enough. I liked it more when it was useful.
        </p>
        <p>
          Somewhere along the way I started coding, just for fun at first. Then I was building websites for a web
          agency, and after that small pieces of software of my own. I hadn’t planned any of it, but I’d found the
          thing I kept coming back to: maths, technology and a problem worth solving, all in one place.
        </p>
        <p>
          So after graduating I took a job that let me use both: software quality engineer. My days went into testing
          systems, chasing bugs and reading the patterns in where things broke. It taught me a healthy suspicion. A
          system that runs isn’t the same as a system that works.
        </p>
        <p>
          But the job kept pulling my attention somewhere else. Following a bug from one part of a system to the next,
          I’d catch myself wondering how the pieces fit together, and how I would have built the feature myself.
          Finding what was broken was satisfying. Building something that wouldn’t break was what I actually wanted to
          do.
        </p>
        <p>
          Machine learning is where those threads meet. It runs on the probability and statistics I enjoyed most, it’s
          built as software, and it fails the way testers fear most: quietly, with a confident answer that’s wrong.
          That’s the work I do now. I take a problem and a pile of data, turn it into a working system, and then check,
          honestly, whether it holds up.
        </p>
        <h2>What I am looking for</h2>
        <p>
          I am open to machine learning engineering roles, and to conversations with people building models that
          have to be trusted.
        </p>
      </div>

      <aside class="about__side" aria-label="Quick facts">
        <div class="side-block">
          <p class="label">Based in</p>
          <p>Bangladesh</p>
        </div>
        <div class="side-block">
          <p class="label">Languages</p>
          <p>English, Bengali (native)</p>
        </div>
        <div class="side-block">
          <p class="label">Stack</p>
          <ul class="stack">
            {stack.map((s) => <li class="tag">{s}</li>)}
          </ul>
        </div>
        <div class="side-actions">
          <a class="btn" href={href('/about/cv')}>Read the CV</a>
          <a class="btn btn--ghost" href={href('/contact')}>Get in touch</a>
        </div>
      </aside>
    </div>

    <section class="path" aria-labelledby="path-title">
      <h2 id="path-title" class="label">The path so far</h2>
      <ol class="path__list">
        {
          path.map((step, i) => (
            <li class="path__step">
              <span class="path__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="path__place label">{step.place}</span>
              <span class="path__what">{step.what}</span>
              <span class="path__detail">{step.detail}</span>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Base>

<style>
  .about {
    row-gap: var(--s7);
    padding-top: var(--s6);
    border-top: 1px solid var(--text);
  }
  .about__portrait {
    grid-column: 1 / span 3;
    margin: 0;
    align-self: start;
  }
  .about__portrait :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(1);
    border-bottom: 3px solid var(--accent);
  }
  .about__story {
    grid-column: 4 / span 6;
  }
  .about__story > p:first-child {
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--text);
  }
  .about__side {
    grid-column: 10 / -1;
    display: grid;
    align-content: start;
    gap: var(--s5);
  }
  .side-block {
    display: grid;
    gap: var(--s2);
    padding-bottom: var(--s4);
    border-bottom: 1px solid var(--rule);
  }
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .side-actions {
    display: grid;
    gap: var(--s2);
  }

  .path {
    margin-top: var(--s10);
    display: grid;
    gap: var(--s5);
  }
  .path__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid var(--text);
  }
  .path__step {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--s2);
    padding: var(--s6) var(--s5) var(--s5) 0;
  }
  .path__step::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--text);
  }
  .path__step:last-child::before {
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .path__num {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .path__what {
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: var(--track-display);
    line-height: 1.15;
  }
  .path__detail {
    color: var(--text-2);
  }

  @media (max-width: 1000px) {
    .about__portrait {
      grid-column: 1 / span 4;
      grid-row: span 2;
    }
    .about__story,
    .about__side {
      grid-column: 5 / -1;
    }
  }
  /* Five steps need about 200px each; below that the timeline runs vertically. */
  @media (max-width: 1000px) {
    .path__list {
      grid-template-columns: 1fr;
      border-top: 0;
      border-left: 1px solid var(--text);
      margin-left: 5px;
    }
    .path__step {
      padding: 0 0 var(--s6) var(--s5);
    }
    .path__step::before {
      top: 4px;
      left: -6px;
    }
  }
  @media (max-width: 760px) {
    .about__portrait,
    .about__story,
    .about__side {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    /* Full column width on phones (square), so there is no gap beside it. */
  }
</style>
